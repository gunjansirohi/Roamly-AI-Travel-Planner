# Frontend (Vercel; values are embedded in the public browser bundle)
VITE_API_URL=https://your-roamly-api.onrender.com
VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key

# Backend (Render; never expose these values in the frontend)
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/roamly
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_API_KEY=your_server_google_maps_key
OPENWEATHER_API_KEY=your_openweather_api_key
JWT_SECRET=replace_with_at_least_32_random_bytes
CLIENT_URL=https://your-roamly-app.vercel.app

# Optional backend tuning
API_TIMEOUT_MS=15000
TRUST_PROXY=true
