{
  "name": "ai-travel-planner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors green,cyan \"npm run backend\" \"npm run frontend\"",
    "dev": "npm run dev --workspace=backend",
    "frontend": "npm run start --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
